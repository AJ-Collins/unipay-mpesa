{
    "openapi": "3.0.0",
    "info": {
        "title": "pulse Module",
        "description": "API documentation for pulse module",
        "contact": {
            "name": "Ananda Douglas",
            "email": "douglasdaggs@gmail.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8082/v2",
            "description": "API Development Server"
        },
        {
            "url": "https://afya365.com/v2",
            "description": "API Staging Server"
        }
    ],
    "paths": {
        "/about": {
            "get": {
                "tags": [
                    "PULSE"
                ],
                "summary": "Module Info. ",
                "responses": {
                    "200": {
                        "description": "success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/About"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {}
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "About": {
                "properties": {
                    "id": {
                        "title": "Module ID",
                        "type": "string",
                        "example": "PULSE"
                    },
                    "name": {
                        "title": "Module Name",
                        "type": "string",
                        "example": "PULSE Module"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            },
            "cookieAuth": {
                "type": "http",
                "name": "refresh-token",
                "in": "cookie",
                "scheme": "bearer"
            }
        }
    },
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "tags": [
        {
            "name": "PULSE",
            "description": "Endpoints for the PULSE module"
        }
    ]
}