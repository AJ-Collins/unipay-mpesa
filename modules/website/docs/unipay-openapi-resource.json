        }
    ],
    "paths": {
        "/unipay/mpesa/stk-push": {
            "post": {
                "tags": [
                    "M-Pesa"
                ],
                "summary": "STK Push",
                "description": "Prompt customer to pay via M-Pesa on their phone (Lipa Na M-Pesa Online).",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "phone",
                                    "amount",
                                    "account_ref"
                                ],
                                "properties": {
                                    "phone": {
                                        "type": "string",
                                        "example": "0712345678"
                                    },
                                    "amount": {
                                        "type": "number",
                                        "example": 100
                                    },
                                    "account_ref": {
                                        "type": "string",
                                        "example": "INV-001"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Order payment"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "STK Push initiated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "dataPayload": {
                                            "properties": {
                                                "data": {
                                                    "properties": {
                                                        "CheckoutRequestID": {
                                                            "type": "string"
                                                        },
                                                        "MerchantRequestID": {
                                                            "type": "string"
                                                        },
                                                        "ResponseCode": {
                                                            "type": "string"
                                                        },
                                                        "ResponseDescription": {
                                                            "type": "string"
                                                        },
                                                        "CustomerMessage": {
                                                            "type": "string"
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/unipay/mpesa/stk-query": {
            "post": {
                "tags": [
                    "M-Pesa"
                ],
                "summary": "STK Push Query",
                "description": "Check the status of a pending STK Push transaction.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "checkout_request_id"
                                ],
                                "properties": {
                                    "checkout_request_id": {
                                        "type": "string",
                                        "example": "ws_CO_260520211133524545"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Query result"
                    }
                }
            }
        },
        "/unipay/mpesa/c2b-register": {
            "post": {
                "tags": [
                    "M-Pesa"
                ],
                "summary": "Register C2B URLs",
                "description": "Register Validation and Confirmation URLs for paybill/till C2B payments.",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "response_type": {
                                        "type": "string",
                                        "example": "Completed"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "URLs registered successfully"
                    }
                }
            }
        },
        "/unipay/mpesa/c2b-simulate": {
            "post": {
                "tags": [
                    "M-Pesa"
                ],
                "summary": "Simulate C2B (Sandbox only)",
                "description": "Simulate a customer-to-business payment in sandbox environment.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "phone",
                                    "amount"
                                ],
                                "properties": {
                                    "phone": {
                                        "type": "string",
                                        "example": "254712345678"
                                    },
                                    "amount": {
                                        "type": "number",
                                        "example": 10
                                    },
                                    "bill_ref": {
                                        "type": "string",
                                        "example": "TEST123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Simulation accepted"
                    }
                }
            }
        },
        "/unipay/mpesa/b2c": {
            "post": {
                "tags": [
                    "M-Pesa"
                ],
                "summary": "B2C Payment",
                "description": "Send money from business shortcode to a customer M-Pesa wallet (salary, refunds, promotions).",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "phone",
                                    "amount"
                                ],
                                "properties": {
                                    "phone": {
                                        "type": "string",
                                        "example": "0712345678"
                                    },
                                    "amount": {
                                        "type": "number",
                                        "example": 500
                                    },
                                    "command_id": {
                                        "type": "string",
                                        "example": "BusinessPayment"
                                    },
                                    "remarks": {
                                        "type": "string",
                                        "example": "Refund"
                                    },
                                    "occasion": {
                                        "type": "string",
                                        "example": ""
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "B2C initiated"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/unipay/mpesa/b2b": {
            "post": {
                "tags": [
                    "M-Pesa"
                ],
                "summary": "B2B Payment",
                "description": "Send money to another business paybill or till number.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "receiver_shortcode",
                                    "amount"
                                ],
                                "properties": {
                                    "receiver_shortcode": {
                                        "type": "string",
                                        "example": "600000"
                                    },
                                    "amount": {
                                        "type": "number",
                                        "example": 1000
                                    },
                                    "command_id": {
                                        "type": "string",
                                        "example": "BusinessPayBill"
                                    },
                                    "account_ref": {
                                        "type": "string",
                                        "example": "INV-B2B-001"
                                    },
                                    "remarks": {
                                        "type": "string",
                                        "example": "Supplier payment"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "B2B initiated"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/unipay/mpesa/transaction-status": {
            "post": {
                "tags": [
                    "M-Pesa"
                ],
                "summary": "Transaction Status Query",
                "description": "Query the current status of any M-Pesa transaction by receipt number.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "transaction_id"
                                ],
                                "properties": {
                                    "transaction_id": {
                                        "type": "string",
                                        "example": "OEI2AK4DKL"
                                    },
                                    "identifier_type": {
                                        "type": "string",
                                        "example": "4"
                                    },
                                    "remarks": {
                                        "type": "string",
                                        "example": "Status check"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Status query accepted"
                    }
                }
            }
        },
        "/unipay/mpesa/account-balance": {
            "post": {
                "tags": [
                    "M-Pesa"
                ],
                "summary": "Account Balance",
                "description": "Query M-Pesa account balance for your registered shortcode.",
                "responses": {
                    "200": {
                        "description": "Balance query accepted"
                    }
                }
            }
        },
        "/unipay/mpesa/reversal": {
            "post": {
                "tags": [
                    "M-Pesa"
                ],
                "summary": "Transaction Reversal",
                "description": "Initiate a reversal for a completed M-Pesa transaction.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "transaction_id",
                                    "amount"
                                ],
                                "properties": {
                                    "transaction_id": {
                                        "type": "string",
                                        "example": "OEI2AK4DKL"
                                    },
                                    "amount": {
                                        "type": "number",
                                        "example": 100
                                    },
                                    "receiver_id_type": {
                                        "type": "string",
                                        "example": "11"
                                    },
                                    "remarks": {
                                        "type": "string",
                                        "example": "Reversal"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Reversal initiated"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/unipay/mpesa/transactions": {
            "get": {
                "tags": [
                    "M-Pesa"
                ],
                "summary": "List Transactions",
                "description": "Paginated list of M-Pesa transactions. Admins see all; users see their own.",
                "parameters": [
                    {
                        "name": "type",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "example": "C2B"
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "example": "SUCCESS"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated transactions list"
                    }
                }
            }
        },
        "/unipay/mpesa/transactions/{id}": {
            "get": {
                "tags": [
                    "M-Pesa"
                ],
                "summary": "Get Transaction",
                "description": "Retrieve a single transaction with responses and reconciliation data.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Transaction detail"
                    },
                    "404": {
                        "description": "Not found"
                    }
                }
            }
        }
    },
